# Exemplo de variáveis de ambiente do Backend
PROJECT_NAME="Projeto Base"
API_V1_STR="/api/v1"
# Ambiente de Execução: 'development' ou 'production' (em produção, ativa proteção rigorosa Anti-SSRF para webhooks)
ENVIRONMENT="development"


# Banco de Dados
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/projetobase"

# Segurança JWT
SECRET_KEY="supersecret-jwt-key-projeto-base-981273491"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credenciais Iniciais do Super Admin
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="aryarajmarketing@gmail.com"
SUPERADMIN_PASSWORD="SuperAdmin@2026!"

# Pepper do Sistema (Argon2id + HMAC-SHA256 - Chave Secreta do Servidor)
SECURITY_PASSWORD_PEPPER="d6e3f89a2b5c4701e1c9d8a4f3b207e691238475a1092837465bcdf012938475"

# Brevo (Envio de E-mail via API REST)
BREVO_API_KEY="xkeysib-seu-api-key-aqui"
BREVO_SENDER_EMAIL="remetente-validado@seudominio.com"
BREVO_SENDER_NAME="Projeto Base"

# [OPCIONAL / RECOMENDADO] Armazenamento de Backups em Nuvem (Backblaze B2 / AWS S3)
# O sistema aceita tanto BACKBLAZE_* quanto B2_*
BACKBLAZE_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"
BACKBLAZE_KEY_ID="seu-application-key-id"
BACKBLAZE_APPLICATION_KEY="seu-application-key-secreto"
BACKBLAZE_BUCKET_NAME="seu-bucket-de-backup"
BACKBLAZE_CDN_URL="https://s3.us-west-004.backblazeb2.com/seu-bucket-de-backup"
B2_FOLDER="projetobase/backups/"
# Limite máximo de retenção de dumps no S3 antes de expurgar o mais antigo
B2_RETENTION_MAX=30
# [OPCIONAL] Integração com Google Agenda (OAuth 2.0)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/forms/integrations/google-calendar/callback"

# [OPCIONAL] Rate Limiting (Requisições permitidas por minuto por IP)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_VERIFY_OTP=5
RATE_LIMIT_PUBLIC_FORMS=30
RATE_LIMIT_AUTHENTICATED=200

# [OPCIONAL / SEGURANÇA] CORS Granular (Origens autorizadas separadas por vírgula)
# Em produção, defina o domínio real do frontend: ex: "https://meuapp.com,https://dashboard.meuapp.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002"

# [OPCIONAL / RECOMENDADO] Chave de Criptografia Simétrica (Fernet AES-128-CBC + HMAC-SHA256)
# Usada para criptografar em repouso no banco os tokens do Google Agenda.
# Pode ser gerada com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se não preenchida, o sistema deriva automaticamente da SECRET_KEY.
SECURITY_ENCRYPTION_KEY="exemplo-chave-fernet-base64-32bytes-urlsafe=="



